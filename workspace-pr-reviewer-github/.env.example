# OpenAI (required for run_review.mjs; usually already set for the Gateway)
OPENAI_API_KEY=sk-replace

# GitHub: PAT with repo/contents read for PRs; must allow **issue comments** on the target repo
# (PR comments = POST /repos/.../issues/{number}/comments). See README.md
GITHUB_TOKEN=ghp_replace
# PR_REVIEW_GITHUB_API_BASE=https://api.github.example.com

# Webhook (GitHub “Secret” in webhook settings) — HMAC
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string
# Local testing only: allow requests without a valid secret
# ALLOW_INSECURE_WEBHOOK=1

# Where this package lives on the Gateway (Docker default below)
PR_REVIEWER_WORKSPACE=/home/node/.openclaw/workspace-pr-reviewer-github
PR_REVIEWER_AGENT_ID=pr-reviewer-github
GITHUB_PR_WEBHOOK_PORT=3457
PR_REVIEWER_COALESCE_MS=2500
PR_REVIEWER_AGENT_TIMEOUT_MS=600000

# Slack: bot that can chat.postMessage to the review channel
SLACK_BOT_TOKEN=xoxb-replace
PR_REVIEW_SLACK_CHANNEL_ID=C01234567890

# Model for review
# PR_REVIEW_OPENAI_MODEL=gpt-4o-mini
# PR_REVIEW_MAX_DIFF_CHARS=400000
